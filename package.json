{
  "name": "crypto-ia",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2",
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "observe": "bun src/main.ts observe",
    "build": "bun build src/main.ts --target=bun --outdir=dist",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "hooks:install": "lefthook install",
    "commit": "cz",
    "secrets:check": "bun tools/secret-scan.ts",
    "license:check": "bun tools/licenseChecker.ts",
    "worktree:setup": "bun tools/worktree-setup.ts",
    "worktree:teardown": "bun tools/worktree-teardown.ts"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/bun": "1.4.2",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "lefthook": "2.1.12",
    "typescript": "6.0.3",
    "typescript-language-server": "6.0.0"
  }
}
